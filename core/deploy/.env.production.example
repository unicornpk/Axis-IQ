APP_NAME="Axis IQ Core"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://CHANGE-ME/axisiq

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# SQLite by default — no DB credentials to set up, fine for this app's
# only table (a conversation log). Switch to mysql below if you'd rather
# match your other apps; see ../DEPLOY.md.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=
# DB_USERNAME=
# DB_PASSWORD=

# No shell/cron workers available on a no-SSH host, so keep everything
# synchronous/file-based rather than relying on a queue worker.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

MAIL_MAILER=log

# --- Axis IQ -----------------------------------------------------------

IQ_ANTHROPIC_API_KEY=
IQ_ANTHROPIC_MODEL=claude-sonnet-5-5
IQ_ANTHROPIC_MAX_TOKENS=1024
IQ_ANTHROPIC_MAX_TOOL_ITERATIONS=4

# Every caller (a product's own backend proxy) must send this as
# `Authorization: Bearer <value>`. Generate a fresh long random value per
# deployment — do not reuse one across environments — and put the SAME
# value into each calling product's own settings (e.g. AxisField ->
# Settings -> "Axis IQ assistant" -> "Access secret").
IQ_CALLER_TOKEN=

# Field (AxisField nosaas) connector's shared service token — from
# AxisField -> Settings -> "Axis IQ API token".
IQ_FIELD_API_TOKEN=

# Field's base URL — override if it's moved off unicornaxis.com.
# IQ_FIELD_URL=https://field.unicornaxis.com/app

# One-time use only: lets axisiq/install.php run the DB migration over
# plain HTTP on a host with no shell. Generate a fresh random value per
# deployment, and DELETE axisiq/install.php from the server immediately
# after running it once — see ../DEPLOY.md.
IQ_INSTALL_CODE=
